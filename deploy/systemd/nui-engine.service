[Unit]
Description=NUI engine (gesture recognition core, N1..N6)
Documentation=file:/opt/nui/README.md
After=network.target
# engine is the UDS server; it must start before the client services.

[Service]
Type=simple
User=nui
Group=nui
Environment=NUI_PERCEPTION_SOCK=/run/nui/perception.sock
Environment=NUI_UI_SOCK=/run/nui/ui.sock
Environment=NUI_CALIB=/etc/nui/calibration.matrix
ExecStart=/opt/nui/bin/nui-engine
Restart=on-failure
RestartSec=1

# --- Hardening: engine touches no devices, only the local UDS bus. ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/nui

[Install]
WantedBy=multi-user.target
